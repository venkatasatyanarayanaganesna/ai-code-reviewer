# AI Provider Configuration
# Choose: groq (free API) or ollama (local, no internet)

AI_PROVIDER=groq

# Groq Configuration (Free API - get key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Configuration (Local AI - no API needed)
# Install from https://ollama.ai, then run: ollama pull llama3.1
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# Server Configuration
PORT=3001
NODE_ENV=development
